{
	"appId": "com.kvp.salesnavigator",
	"appName": "SalesNavigator",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"cleartext": true
	},
	"webView": {
		"allowMixedContent": true
	},
	"android": {
		"webContentsDebuggingEnabled": true
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 0
		},
		"CapacitorCookies": {
			"enabled": true
		}
	},
	"packageClassList": [
		"AppPlugin",
		"CAPCameraPlugin",
		"DevicePlugin",
		"FilesystemPlugin",
		"GeolocationPlugin",
		"LocalNotificationsPlugin",
		"CAPNetworkPlugin",
		"PreferencesPlugin",
		"NativeSettingsPlugin"
	]
}
