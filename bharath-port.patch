+          Ticket Assistant
+        </div>
+        <div className="space-y-2">
+          {CATEGORIES.map((c) => {
+            const Icon = c.icon;
+            return (
+              <button
+                key={c.key}
+                type="button"
+                onClick={() => setActive(c)}
+                className={`w-full rounded-lg border p-2.5 text-left transition ${c.cls}`}
