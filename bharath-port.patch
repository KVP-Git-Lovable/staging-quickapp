+          if (!m) return; // product no longer active — never suggest it
+          const t = typicalLine(p.unitLines);
+          const daysSince = p.lastDate
+            ? Math.round((now.getTime() - new Date(`${p.lastDate}T00:00:00Z`).getTime()) / DAY_MS)
+            : null;
+          addCandidate({
+            productId: m.id,
+            name: m.name,
+            qty: t.qty,
+            unit: t.unit || m.unit || "",
+            tag: "regular",
