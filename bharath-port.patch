+        const t = typicalLine(p.unitLines);
+        addCandidate({
+          productId: m.id,
+          name: m.name,
+          qty: t.qty,
+          unit: t.unit || m.unit || "",
+          tag: "reorder",
+          signal: `Bought ${p.lines}× before, last ${p.daysSince}d ago — likely due to reorder (usually ${t.qty}${t.unit ? ` ${t.unit}` : ""})`,
+        });
+      });
